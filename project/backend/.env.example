# PostgreSQL connection string from Render (Internal or External Database URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000

# Face verification
FACE_MATCH_THRESHOLD=0.6

# Anti-cheat monitoring interval hint for frontend (seconds)
FACE_CHECK_INTERVAL_SECONDS=7

# Head pose thresholds (degrees). An angle alone is never treated as cheating -
# it must also be held past the durations below before an event is raised.
HEAD_POSE_CENTER_TOLERANCE=12
HEAD_POSE_WARNING_YAW=15
HEAD_POSE_WARNING_PITCH=15
HEAD_POSE_CRITICAL_YAW=25
HEAD_POSE_CRITICAL_PITCH=25

# How long an off-center pose must be held (seconds)
POSE_WARNING_DURATION=3
POSE_SUSPICIOUS_DURATION=8

# Identical repeated events inside this window merge into one row (0 = disable)
EVENT_COOLDOWN_SECONDS=15
